rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.uid == existing().uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Analyses collection
    match /analyses/{analysisId} {
      function isValidAnalysis(data) {
        return data.userId == request.auth.uid
          && data.season in ['Winter', 'Spring', 'Summer', 'Autumn']
          && data.jewelry in ['Gold', 'Silver']
          && data.bestColors is list
          && data.bestColors.size() == 5
          && data.avoidColors is list
          && data.avoidColors.size() == 5;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidAnalysis(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinnedProfile']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
